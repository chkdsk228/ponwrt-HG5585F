#!/bin/sh
# ============================================================
# chkdsk228 定制项（按 wuziwei/ponwrt-ZN504-HG5585F 的 uci-defaults 格式）
#
# 注入的四项定制：
#   1. 设备主机名 OWRT
#   2. 后台地址 192.168.10.1
#   3. 构建者标识 build by chkdsk228
#   4. 固件命名用编译时间戳（在 .github/workflows/build-zn504.yml 中实现）
#
# 上游基线: wuziwei/ponwrt-ZN504-HG5585F @ 2a9ccb19 (2026-11-22)
# 仓库: 独立仓库 chkdsk228/ponwrt-HG5585F（非 fork，Actions 无门槛）
# 命名前缀 98- 保证在 99-custom-settings 之前执行，
# 让上游的 99-custom-settings 能覆盖本文件的任何冲突项。
# ============================================================

# 1. 设备主机名
uci -q set system.@system[0].hostname='OWRT'
uci -q commit system

# 2. 后台地址（上游 99-custom-settings 未设 IP，此处为唯一来源）
uci -q set network.lan.ipaddr='192.168.10.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q commit network

# 3. 构建者标识 build by chkdsk228
#    LuCI 状态页读取 10_system.js 中的 luciversion 拼接串
for JS in /www/luci-static/resources/view/status/10_system.js \
          /usr/share/luci/menu.d/10_system.js; do
    [ -f "$JS" ] && sed -i "s/(\(luciversion || ''\))/(\1) + (' \/ build by chkdsk228')/g" "$JS" 2>/dev/null || true
done

exit 0
